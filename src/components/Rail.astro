---
import { siteConfig } from "../config";

const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
const hasEducation = siteConfig.education && siteConfig.education.length > 0;
---

<div class="navrail" id="rail">
  <a href="#about" class="active">
    <span class="ind">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
        <circle cx="12" cy="8" r="3.2"></circle>
        <path d="M5 20c1.5-3.5 4-5 7-5s5.5 1.5 7 5"></path>
      </svg>
    </span>
    <span>About</span>
  </a>
  {
    hasProjects && (
      <a href="#systems">
        <span class="ind">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <rect x="4" y="4" width="7" height="7" rx="1.5" />
            <rect x="13" y="4" width="7" height="7" rx="1.5" />
            <rect x="4" y="13" width="7" height="7" rx="1.5" />
            <rect x="13" y="13" width="7" height="7" rx="1.5" />
          </svg>
        </span>
        <span>Systems</span>
      </a>
    )
  }
  {
    hasExperience && (
      <a href="#log">
        <span class="ind">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M5 4h11l3 3v13H5z" />
            <path d="M9 11h6M9 15h6" />
          </svg>
        </span>
        <span>Log</span>
      </a>
    )
  }
  {
    hasEducation && (
      <a href="#edu">
        <span class="ind">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M3 8l9-4l9 4l-9 4z" />
            <path d="M7 10.5V16c2 1.5 8 1.5 10 0v-5.5" />
          </svg>
        </span>
        <span>Edu</span>
      </a>
    )
  }
</div>

<script>
  const links = document.querySelectorAll<HTMLAnchorElement>("#rail a");
  const sections = Array.from(links)
    .map((a) => document.getElementById(a.getAttribute("href")!.slice(1)))
    .filter((el): el is HTMLElement => !!el);

  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            links.forEach((a) => a.classList.remove("active"));
            const match = document.querySelector(`#rail a[href="#${entry.target.id}"]`);
            match?.classList.add("active");
          }
        });
      },
      { rootMargin: "-40% 0px -50% 0px" }
    );
    sections.forEach((s) => io.observe(s));
  }
</script>
