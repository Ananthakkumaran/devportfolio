---
import { siteConfig } from "../config";

const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
const total = siteConfig.experience?.length ?? 0;
---

{
  hasExperience && (
    <section id="log" class="sec">
      <div class="wrap">
        <div class="sec-head">
          <span class="sec-title head">Field log</span>
          <span class="sec-rule" />
        </div>

        <div class="changelog">
          {siteConfig.experience.map((exp, index) => (
            <div class="release">
              <div class="release-card">
                <div class="release-head">
                  <span class="release-ver mono">
                    v{total - index}.0.0
                    {index === 0 ? " · CURRENT" : ""}
                  </span>
                  <span class="release-date mono">{exp.dateRange.toUpperCase()}</span>
                </div>
                <h3>{exp.title}</h3>
                <div class="release-co">{exp.company}</div>
                {exp.companyDescription && <div class="release-co-desc">{exp.companyDescription}</div>}
                <div class="release-loc">{exp.location.toUpperCase()}</div>
                <div class="release-notes">
                  {exp.bullets.map((bullet) => (
                    <div>{bullet}</div>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}
