---
import { siteConfig } from "../config";

const initials = siteConfig.name
  .split(" ")
  .map((p) => p[0])
  .join("")
  .slice(0, 2)
  .toUpperCase();
---

<div class="appbar">
  <div class="brand"><span class="mark">{initials}</span> {siteConfig.name.split(" ")[0]}</div>
  <div class="chip-status"><span class="dot"></span>{siteConfig.availability.split("·")[0].trim()}</div>
</div>

<style>
  html {
    scroll-behavior: smooth;
  }
</style>
