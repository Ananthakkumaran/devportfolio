---
import { siteConfig } from "../config";
---

<footer>
  <div class="wrap foot-row">
    <div class="foot-links">
      {siteConfig.social?.email && <a href={`mailto:${siteConfig.social.email}`}>Email</a>}
      {siteConfig.social?.linkedin && (
        <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      )}
      {siteConfig.social?.github && (
        <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      )}
    </div>
    <span class="build-tag mono">
      BUILD {new Date().getFullYear()}.{String(new Date().getMonth() + 1).padStart(2, "0")} &middot; {siteConfig.location.toUpperCase()}
    </span>
  </div>
</footer>
