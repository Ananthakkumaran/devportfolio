---
import { siteConfig } from "../config";
const hasEducation = siteConfig.education && siteConfig.education.length > 0;
---

{
  hasEducation && (
    <section id="edu" class="sec">
      <div class="wrap">
        <div class="sec-head">
          <span class="sec-title head">Education</span>
          <span class="sec-rule" />
        </div>

        {siteConfig.education.map((edu) => (
          <div class="edu-row">
            <div>
              <h3>{edu.degree}</h3>
              <div class="school">{edu.school}</div>
              {edu.achievements.length > 0 && (
                <div class="edu-achievements">
                  {edu.achievements.map((achievement) => (
                    <div>{achievement}</div>
                  ))}
                </div>
              )}
            </div>
            <span class="edu-range mono">{edu.dateRange}</span>
          </div>
        ))}
      </div>
    </section>
  )
}
