---
import { siteConfig } from "../config";

const initials = siteConfig.name
  .split(" ")
  .map((p) => p[0])
  .join("")
  .slice(0, 2)
  .toUpperCase();

const systemsCount = siteConfig.projects?.length ?? 0;
---

<section class="hero">
  <div class="wrap">
    <div class="icon-badge">{initials}</div>
    <div class="version-tag mono"><b>v8.2.0</b>&nbsp;&middot;&nbsp;stable release</div>
    <h1 class="name">{siteConfig.name}</h1>
    <p class="role">{siteConfig.title}</p>
    <p class="tagline">Kotlin, Jetpack Compose and AWS &mdash; building mobile systems that hold up in production, from fintech to fleet IoT.</p>

    <div class="stats">
      <div class="stat"><b>8+</b><span>Years shipping Android</span></div>
      <div class="stat"><b>{systemsCount}</b><span>Systems in production</span></div>
      <div class="stat"><b>1,000+</b><span>Daily active users</span></div>
    </div>

    <div class="btnrow">
      {siteConfig.social?.email && (
        <a class="btn btn-filled" href={`mailto:${siteConfig.social.email}`}>Email me</a>
      )}
      {siteConfig.social?.phone && (
        <a class="btn btn-outline" href={`tel:${siteConfig.social.phone.replace(/\s+/g, "")}`}>{siteConfig.social.phone}</a>
      )}
      {siteConfig.social?.linkedin && (
        <a class="btn btn-outline" href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      )}
      {siteConfig.social?.github && (
        <a class="btn btn-outline" href={siteConfig.social.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      )}
    </div>
  </div>
</section>
