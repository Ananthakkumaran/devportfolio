---
import { siteConfig } from "../config";

const projects = siteConfig.projects || [];

function initials(name: string) {
  const clean = name.split(/[—–-]/)[0].trim();
  const words = clean.split(/\s+/).filter(Boolean);
  if (words.length === 1) return words[0].slice(0, 2).toUpperCase();
  return (words[0][0] + words[1][0]).toUpperCase();
}

const mutedStatuses = new Set(["Archived"]);
---

<section id="systems" class="sec">
  <div class="wrap">
    <div class="sec-head">
      <span class="sec-title head">Selected systems</span>
      <span class="sec-rule"></span>
    </div>

    {
      projects.map((project) => {
        const Component = project.link ? "a" : "div";
        const linkProps = project.link
          ? { href: project.link, target: "_blank", rel: "noopener noreferrer" }
          : {};
        const isActive = !mutedStatuses.has(project.status ?? "");

        return (
          <Component class="card" {...linkProps}>
            <div class="card-top">
              <div class="card-icon">{initials(project.name)}</div>
              <div class="card-meta">
                <div>
                  <h3>{project.name}</h3>
                  <div class="year mono">{project.year}</div>
                </div>
              </div>
              {project.status && (
                <span class="status-pill">
                  <span class="dot" style={isActive ? "" : "background:var(--text-muted)"} />
                  {project.status}
                </span>
              )}
            </div>
            <p>{project.description}</p>
            {project.impact && <div class="card-impact">{project.impact}</div>}
            {project.skills && project.skills.length > 0 && (
              <div class="card-tags">
                {project.skills.map((skill) => (
                  <span>{skill}</span>
                ))}
              </div>
            )}
            {project.link && <div class="card-link">View live &rarr;</div>}
          </Component>
        );
      })
    }
  </div>
</section>
